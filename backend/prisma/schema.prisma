generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DocumentType {
  CC
  CE
  PASSPORT
  NIT
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PayrollNoveltyType {
  OVERTIME
  BONUS
  COMMISSION
  ALLOWANCE
  DEDUCTION
  ABSENCE
  SICK_LEAVE
  VACATION
  OTHER_EARNING
  OTHER_DEDUCTION
}

model Employee {
  id               Int               @id @default(autoincrement())
  employeeCode     String            @unique
  documentType     DocumentType
  documentNumber   String            @unique
  firstName        String
  lastName         String
  email            String?           @unique
  phone            String?
  position         String
  department       String
  baseSalary       Decimal           @db.Decimal(12, 2)
  hireDate         DateTime
  employmentStatus EmploymentStatus  @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payrolls         PayrollEmployee[]
}

model Payroll {
  id        Int               @id @default(autoincrement())
  period    String
  startDate DateTime
  endDate   DateTime
  status    PayrollStatus     @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  employees PayrollEmployee[]
}

model PayrollEmployee {
  id         Int @id @default(autoincrement())
  payrollId  Int
  employeeId Int

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  novelties PayrollNovelty[]

  createdAt DateTime @default(now())

  @@unique([payrollId, employeeId])
}

model PayrollNovelty {
  id                Int                @id @default(autoincrement())
  payrollEmployeeId Int
  type              PayrollNoveltyType
  description       String?
  quantity          Decimal?           @db.Decimal(10, 2)
  amount            Decimal            @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  payrollEmployee PayrollEmployee @relation(fields: [payrollEmployeeId], references: [id])

  @@index([payrollEmployeeId])
}
