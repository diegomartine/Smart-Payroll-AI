generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Position {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model Employee {
  id               Int              @id @default(autoincrement())
  employeeCode     String           @unique
  documentType     DocumentType
  documentNumber   String           @unique
  firstName        String
  lastName         String
  email            String?          @unique
  phone            String?
  positionId       Int
  departmentId     Int
  baseSalary       Decimal          @db.Decimal(12, 2)
  hireDate         DateTime
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  position   Position   @relation(fields: [positionId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  payrolls PayrollEmployee[]
}

model Payroll {
  id        Int               @id @default(autoincrement())
  period    String
  startDate DateTime
  endDate   DateTime
  status    PayrollStatus     @default(DRAFT)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  employees PayrollEmployee[]
}

model PayrollEmployee {
  id                 Int      @id @default(autoincrement())
  payrollId          Int
  employeeId         Int
  workedDays         Int?
  baseSalary         Decimal? @db.Decimal(12, 2)
  overtimeHours      Decimal  @default(0) @db.Decimal(10, 2)
  overtimeValue      Decimal  @default(0) @db.Decimal(12, 2)
  bonus              Decimal  @default(0) @db.Decimal(12, 2)
  transportAllowance Decimal  @default(0) @db.Decimal(12, 2)
  otherIncome        Decimal  @default(0) @db.Decimal(12, 2)
  healthDeduction    Decimal  @default(0) @db.Decimal(12, 2)
  pensionDeduction   Decimal  @default(0) @db.Decimal(12, 2)
  otherDeductions    Decimal  @default(0) @db.Decimal(12, 2)
  netSalary          Decimal? @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  employee  Employee         @relation(fields: [employeeId], references: [id])
  payroll   Payroll          @relation(fields: [payrollId], references: [id])
  novelties PayrollNovelty[]

  @@unique([payrollId, employeeId])
}

model PayrollNovelty {
  id                Int                @id @default(autoincrement())
  payrollEmployeeId Int
  type              PayrollNoveltyType
  description       String?
  quantity          Decimal?           @db.Decimal(10, 2)
  amount            Decimal            @db.Decimal(12, 2)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payrollEmployee   PayrollEmployee    @relation(fields: [payrollEmployeeId], references: [id])

  @@index([payrollEmployeeId])
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DocumentType {
  CC
  CE
  PASSPORT
  NIT
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PayrollNoveltyType {
  OVERTIME
  BONUS
  COMMISSION
  ALLOWANCE
  DEDUCTION
  ABSENCE
  SICK_LEAVE
  VACATION
  OTHER_EARNING
  OTHER_DEDUCTION
}
